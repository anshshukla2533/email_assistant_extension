{
    "manifest_version": 3,
    "name": "AI Email Copilot for Gmail",
    "version": "1.0.0",
    "description": "Contextual AI Email Writing, Tone Shifting, Thread Summarization & Analytics inside Gmail.",
    "permissions": [
        "storage",
        "activeTab",
        "scripting",
        "contextMenus",
        "sidePanel"
    ],
    "host_permissions": [
        "https://mail.google.com/*",
        "https://api.openai.com/*",
        "https://api.anthropic.com/*",
        "https://generativelanguage.googleapis.com/*"
    ],
    "background": {
        "service_worker": "src/background/serviceWorker.ts",
        "type": "module"
    },
    "content_scripts": [
        {
            "matches": [
                "https://mail.google.com/*"
            ],
            "js": [
                "src/content/index.tsx"
            ],
            "run_at": "document_idle"
        }
    ],
    "commands": {
        "toggle-copilot": {
            "suggested_key": {
                "default": "Ctrl+Shift+Y",
                "mac": "Command+Shift+Y"
            },
            "description": "Toggle AI Email Copilot"
        }
    },
    "action": {
        "default_title": "AI Email Assistant"
    },
    "side_panel": {
        "default_path": "src/sidepanel/index.html"
    },
    "options_ui": {
        "page": "src/options/index.html",
        "open_in_tab": true
    },
    "web_accessible_resources": [
        {
            "resources": [
                "src/styles/globals.css"
            ],
            "matches": [
                "https://mail.google.com/*"
            ]
        }
    ]
}
